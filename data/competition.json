  "rules": {
    "version": "S3 / 0.2.2",
    "sections": [
      {
        "id": "format",
        "title": "基础规则",
        "paragraphs": [
          "比赛难度：n15。",
          "比赛分为两个阶段：晋级赛与决赛。"
        ],
        "items": [
          "比赛为团队赛制，共设有五支队伍，每队四名选手；队伍总分为全体队员得分之和。晋级赛中，总积分排名前两名的队伍进入决赛。",
          "每位选手在初赛进行一场比赛；晋级决赛的两支队伍，其四名选手各进行一场决赛。",
          "最终排名中，晋级队伍使用决赛分数，其余队伍使用初赛分数，不累计两个阶段分数。",
          "选手在比赛期间不得与队友、解说席交流。",
          "严禁使用恶性 Bug 或外挂。若使用疑似 Bug，将由主办方讨论后确定其性质是否为恶性。"
        ],
        "callout": "初赛每天一场、每天一名选手；决赛每天一场、每天一名决赛选手。"
      },
      {
        "id": "limits",
        "title": "限制规则",
        "paragraphs": [],
        "items": [
          "干员限制：除干员“机械师”外，每队每名六星干员只能使用两次，临时招募不计入使用次数。每队可以额外指定一名六星干员作为“精英探索者”，该干员可以被四名选手不限次数使用。",
          "藏品、加工品、自然物限制：不得主动同时获得藏品“果腹”与藏品“复得之轮”；如被系统强制塞入则可以使用。",
          "自然物“板腱”必须在获取之后遇到的前两个商店类节点中售出；若未售出，离开第二个商店节点后立即丢弃。",
          "加工品“遥控器”与“结构性原理”每名选手每局只能使用一个，重复获取则应立即丢弃。",
          "烧水规则：每位选手第一次在三层及以前死亡可以重开。",
          "资源管理：全队共享余额上限为 200 点，每名队员可以在局内为队伍存入源石锭，但上限锁定为 200。",
          "分队限制：队伍中四名队员开局分队不得重复。"
        ],
        "callout": ""
      },
      {
        "id": "score",
        "title": "分数规则",
        "paragraphs": [
          "基础计分：即游戏内的结算分。",
          "最终得分由基础结算分、分队计分、特殊任务、结局和藏品额外分共同构成；当前规则未设置扣分项。"
        ],
        "subsections": [
          {
            "title": "特殊分队计分",
            "items": [
              "文明开化分队：得分 ×1.12。",
              "多边贸易分队：得分 ×0.88。",
              "开拓者分队与地质调查分队：得分 ×0.95。",
              "矛头分队：+100 分。"
            ]
          },
          {
            "title": "特殊任务计分",
            "items": [
              "通关时长小于一个半小时：+50 分。",
              "临时招募：六星 +50 分；五星及以下 +20 分。",
              "进入六层时同时携带指定藏品：+150 分。",
              "进入二结局命运所指前同时携带“沙盘α”与“沙盘β”：+120 分。",
              "鸭熊鼠狗每击杀一个：+15 分。",
              "进入〈安眠一隅〉节点：+20 分。",
              "进入第五层前通关“无效验尸”：+50 分。",
              "六层得偿所愿提交 3/2/1/0 个藏品：+0/30/60/80 分。",
              "完美的作战十五层以上：+50 分。",
              "在〈黑诞〉或追猎中触发并通关指定事件：按规则加分。",
              "进入六层时持有层数大于等于 5 的“探测先锋”：+100 分。"
            ]
          },
          {
            "title": "结局加分",
            "items": [
              "一结局：80 分。",
              "五层追猎：160 分。",
              "二结局：150 分。",
              "三结局：150 分。",
              "六层追猎：160 分。"
            ]
          },
          {
            "title": "藏品加分",
            "items": [
              "通关时每携带一个藏品：+5 分。"
            ]
          }
        ]
      },
      {
        "id": "reward",
        "title": "奖励",
        "paragraphs": [],
        "items": [
          "参与奖：冷门通行证混池一抽。",
          "第一名队伍：每人 20r。",
          "第二名队伍：每人 15r。",
          "第三名队伍：每人 7.99r。",
          "第四名队伍：每人 3.25r。",
          "第五名队伍：每人加一抽。"
        ]
      }
    ]
  },
